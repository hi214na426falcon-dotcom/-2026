rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー認証チェック
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isPrime() {
      return getUserRole() == 'prime';
    }

    function isManager() {
      return getUserRole() == 'manager';
    }

    function isPartner() {
      return getUserRole() == 'partner';
    }

    function isWorker() {
      return getUserRole() == 'worker';
    }

    // meta（セットアップ状態などのアプリ設定）
    //   read はセットアップ画面が未認証でも参照するため公開
    //   write は管理者のみ
    match /meta/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    // users コレクション
    //   create: 初回セットアップ時（meta/app 未作成）に限り、本人が自分の
    //           ドキュメント（docID = uid）を作成できる。以降は管理者のみ。
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && (!exists(/databases/$(database)/documents/meta/app) || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // companies コレクション
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    // sites コレクション
    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isPrime());
      allow update: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow delete: if isSignedIn() && isAdmin();
    }

    // workers コレクション
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isPrime() || isPartner());
      allow update: if isSignedIn() && (isAdmin() || isPrime() || isPartner());
      allow delete: if isSignedIn() && (isAdmin() || isPrime());
    }

    // documents コレクション
    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow update: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow delete: if isSignedIn() && (isAdmin() || isPrime() || isManager());
    }

    // photos コレクション
    match /photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow update: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow delete: if isSignedIn() && (isAdmin() || isPrime() || isManager());
    }

    // notices コレクション
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isPrime() || isManager());
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    // 管理コレクション
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
