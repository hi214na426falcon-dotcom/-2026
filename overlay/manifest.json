{
  "manifest_version": 3,
  "name": "バイナリー サインツール（表示専用）",
  "version": "0.2.0",
  "description": "webterminal の上に、時間帯別の推奨通貨ペア・想定勝率・連勝/ボーナスステージを表示する予測専用オーバーレイ。発注は一切行わない。",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.babaoption.com/*",
        "https://babaoption.com/*",
        "https://*.theoption.com/*",
        "https://theoption.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
